# Template for .streamlit/secrets.toml (local) or the Secrets box in the
# Streamlit Community Cloud dashboard (deployed). Never commit the real file —
# it's in .gitignore. See app/auth.py for how this is read.
#
# Setup: create a Google OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of <your-app-url>/oauth2callback. Use only the default scopes
# (openid, email, profile) and publish the consent screen to "In production"
# so it isn't capped at 100 test users or expiring every 7 days.

[auth]
redirect_uri        = "https://ai-learning-copilot-ironhack-final-project.streamlit.app/oauth2callback"
# For local testing instead: "http://localhost:8501/oauth2callback"
cookie_secret        = "generate your own: python3 -c \"import secrets; print(secrets.token_urlsafe(32))\""
client_id            = "<from Google Cloud Console>"
client_secret        = "<from Google Cloud Console>"
server_metadata_url  = "https://accounts.google.com/.well-known/openid-configuration"

[access]
# Exact email addresses allowed in, and/or whole domains.
emails  = ["felipe@example.com", "casilda@example.com"]
domains = ["ironhack.com"]
