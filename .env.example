# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env

# Required. Used for embeddings (index build) and the chat model.
OPENAI_API_KEY=sk-...

# Optional, but the brief requires LangSmith and C6 depends on it.
# Each of us uses our OWN key — the free tier is one seat, so we do not share.
# Set TRACING to false if you would rather not trace at all.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=ai-learning-copilot
